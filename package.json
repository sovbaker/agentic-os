{
  "name": "agentic-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/mobile"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run migrate -w @agentic-os/api",
    "dev:api": "npm run dev -w @agentic-os/api",
    "dev:mobile": "npm run start -w @agentic-os/mobile",
    "verify:ui": "node scripts/verify-ui.mjs",
    "build:web": "npm run export:web -w @agentic-os/mobile"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
