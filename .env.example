# Обязательное
DATABASE_URL=postgres://postgres@localhost:5432/agentic_os

# Необязательное: без ключа оркестратор работает на детерминированном
# адаптере — весь контур поднимается и тестируется офлайн, без расходов.
# Проверить боевой ключ: npm run smoke:llm
# ANTHROPIC_API_KEY=sk-ant-...

PORT=8787
LOG_LEVEL=info
DEFAULT_LOCALE=ru-RU
DEFAULT_TIMEZONE=Europe/Moscow

# Тариф нового пользователя. На бете — pro: иначе у тестировщика выключены
# генерация мини-апп и вся проактивность, то есть ровно то, что проверяется.
# DEFAULT_PLAN=pro

# Курс для перевода счёта модели в рубли.
USD_RUB=90

# Ручки без пользовательской сессии. Нет переменной — ручки нет:
# пустое значение НЕ означает «пускать всех».
#
#   INBOUND_SECRET — приём пересланной почты (заголовок x-inbound-secret)
#   METRICS_TOKEN  — продуктовые метрики (заголовок x-metrics-token)
#
# INBOUND_SECRET=
# METRICS_TOKEN=
# INBOUND_DOMAIN=in.example.ru

# CORS. Нативный клиент Origin не шлёт и сюда не попадает — список нужен
# только веб-экспорту. 4173 — порт, на котором его поднимает verify:ui.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:4173

# Клиент. На устройстве localhost недоступен — нужен адрес машины в сети.
# Для сборок значение живёт в apps/mobile/eas.json, а не здесь.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8787
