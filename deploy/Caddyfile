# Обратный прокси с автоматическим сертификатом.
#
# Caddy сам получает и продлевает сертификат Let's Encrypt — для одной
# машины это ровно та часть работы, которую не нужно делать руками.

{$API_DOMAIN} {
	encode zstd gzip

	# Поток задачи идёт по SSE и живёт минутами. Буферизация ответа
	# превратила бы «видно, что происходит» в «долго ничего, потом всё
	# сразу» — то есть убила бы главное, ради чего поток вообще нужен.
	reverse_proxy api:8787 {
		flush_interval -1
	}

	log {
		output stdout
		format json
	}
}
