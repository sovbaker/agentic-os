# Окружение боевой машины. Скопировать в deploy/.env и заполнить.
# Файл .env НЕ коммитится и НЕ попадает в образ.

# Домен, на который смотрит A-запись этой машины. Caddy получит на него
# сертификат сам. Без HTTPS iOS-приложение не увидит сервер: ATS
# запрещает обычный HTTP.
API_DOMAIN=api.example.ru

# База. Пароль сгенерировать: openssl rand -base64 24
POSTGRES_PASSWORD=

# Модель. Без ключа сервер поднимется и будет работать на правилах —
# для беты это не годится, но и не падает.
ANTHROPIC_API_KEY=

# Курс для перевода счёта модели в рубли.
USD_RUB=90

# Тариф нового пользователя на бете.
DEFAULT_PLAN=pro

# Приём пересланной почты: сгенерировать openssl rand -hex 32.
# Пустое значение = ручка выключена (503), а не «пускать всех».
INBOUND_SECRET=
INBOUND_DOMAIN=in.example.ru

# Продуктовые метрики: openssl rand -hex 32.
METRICS_TOKEN=

# CORS. Нативному клиенту не нужен — только веб-версии, если она будет.
CORS_ORIGINS=https://app.example.ru

# Пуши. Включать после того, как в EAS загружены APNs-credentials.
EXPO_PUSH_ENABLED=0

# Поиск. Провайдер любой, лишь бы отвечал JSON и был доступен из РФ.
# Заголовок с ключом у всех разный: X-Subscription-Token (Brave),
# X-API-KEY (Serper).
SEARCH_API_URL=
SEARCH_API_KEY=
SEARCH_API_KEY_HEADER=X-Subscription-Token

# Сколько дней хранить дампы.
BACKUP_KEEP_DAYS=14

LOG_LEVEL=info
