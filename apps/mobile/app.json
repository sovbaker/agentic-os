{
  "expo": {
    "name": "Agentic OS",
    "slug": "agentic-os",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "agenticos",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.agenticos.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Микрофон нужен, чтобы можно было надиктовать задачу голосом.",
        "NSSpeechRecognitionUsageDescription": "Распознавание речи нужно, чтобы превратить надиктованную задачу в текст."
      }
    },
    "android": {
      "package": "ru.agenticos.app",
      "adaptiveIcon": {
        "backgroundColor": "#131316",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#A82D14"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
